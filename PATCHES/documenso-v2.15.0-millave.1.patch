+// This link is intentionally a stable public source-offer tag rather than a
+// deployment setting. It must remain available to every person using the
+// modified signing host and carries no user, document, or runtime data.
+export const SOURCE_OFFER_URL =
+  'https://github.com/RealEstatePR/millave-documenso-source/tree/documenso-v2.15.0-millave.1';
+
+export const SourceOfferBanner = () => (
+  <div className="border-b bg-background px-4 py-1 text-center text-muted-foreground text-xs">
+    <a
+      href={SOURCE_OFFER_URL}
+      target="_blank"
+      rel="noopener noreferrer"
+      referrerPolicy="no-referrer"
+      className="underline underline-offset-2 hover:text-foreground"
+    >
+      Source
+    </a>
+  </div>
+);
