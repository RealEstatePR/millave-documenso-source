@@ -0,0 +1,247 @@
+import { createDecipheriv, createHash, createHmac, hkdfSync, timingSafeEqual } from 'node:crypto';
+
+import { env } from '../../utils/env';
+
+const FORMAT = 'lh1';
+const ISSUER = 'https://millave.pr';
+const AUDIENCE = 'https://sign.millave.pr';
+const TTL_SECONDS = 90;
+const CLOCK_SKEW_SECONDS = 30;
+const MAX_HANDOFF_LENGTH = 4_096;
+const MASTER_KEY_BYTES = 32;
+const KEY_ID_BYTES = 8;
+const GCM_IV_BYTES = 12;
+const GCM_TAG_BYTES = 16;
+
+const HANDOFF_SALT = createHash('sha256').update('millave-esign-locale-handoff-lh1').digest();
+const ENCRYPTION_INFO = Buffer.from('lh1/encryption', 'utf8');
+const SIGNING_INFO = Buffer.from('lh1/signing', 'utf8');
+const TARGET_PATH_PATTERN = /^\/sign\/[A-Za-z0-9_-]{16,128}$/;
+const BASE64URL_PATTERN = /^[A-Za-z0-9_-]+$/;
+const CLAIM_KEYS = ['v', 'iss', 'aud', 'iat', 'exp', 'locale', 'targetPath'] as const;
+
+export type LocaleHandoffClaims = {
+  v: 1;
+  iss: typeof ISSUER;
+  aud: typeof AUDIENCE;
+  iat: number;
+  exp: number;
+  locale: 'es' | 'en';
+  targetPath: string;
+};
+
+type DerivedKey = {
+  keyId: string;
+  encryptionKey: Buffer;
+  signingKey: Buffer;
+};
+
+export type LocaleHandoffKeyringResult = { isValid: true; keys: Map<string, DerivedKey> } | { isValid: false };
+
+export type LocaleHandoffVerification =
+  | { isValid: true; claims: LocaleHandoffClaims }
+  | { isValid: false; isConfigurationError: boolean };
+
+/**
+ * Read the isolated current/previous locale-handoff keyring. This deliberately
+ * does not fall back to any Documenso service key.
+ */
+export const getLocaleHandoffKeyring = (): LocaleHandoffKeyringResult => {
+  const currentMasterKey = decodeMasterKey(env('ESIGN_LOCALE_HANDOFF_KEY'));
+
+  if (!currentMasterKey) {
+    return { isValid: false };
+  }
+
+  const previousValue = env('ESIGN_LOCALE_HANDOFF_KEY_PREVIOUS');
+  const previousMasterKey = previousValue ? decodeMasterKey(previousValue) : null;
+
+  if (previousValue && !previousMasterKey) {
+    return { isValid: false };
+  }
+
+  const keys = [currentMasterKey, previousMasterKey].filter((key): key is Buffer => key !== null).map(deriveKey);
+  const keysById = new Map<string, DerivedKey>();
+
+  for (const key of keys) {
+    // A key-id collision would make candidate selection ambiguous. Treat it as
+    // malformed configuration instead of accepting an arbitrary candidate.
+    if (keysById.has(key.keyId)) {
+      return { isValid: false };
+    }
+
+    keysById.set(key.keyId, key);
+  }
+
+  return { isValid: true, keys: keysById };
+};
+
+export const verifyLocaleHandoff = (
+  handoff: string,
+  now = Math.floor(Date.now() / 1_000),
+): LocaleHandoffVerification => {
+  const keyring = getLocaleHandoffKeyring();
+
+  if (!keyring.isValid) {
+    return { isValid: false, isConfigurationError: true };
+  }
+
+  if (handoff.length === 0 || handoff.length > MAX_HANDOFF_LENGTH) {
+    return { isValid: false, isConfigurationError: false };
+  }
+
+  const parts = handoff.split('.');
+
+  if (parts.length !== 6 || parts[0] !== FORMAT) {
+    return { isValid: false, isConfigurationError: false };
+  }
+
+  const [format, keyId, ivValue, ciphertextValue, tagValue, macValue] = parts;
+  const iv = decodeBase64Url(ivValue);
+  const ciphertext = decodeBase64Url(ciphertextValue);
+  const tag = decodeBase64Url(tagValue);
+  const mac = decodeBase64Url(macValue);
+  const decodedKeyId = decodeBase64Url(keyId);
+
+  if (
+    !iv ||
+    !ciphertext ||
+    !tag ||
+    !mac ||
+    !decodedKeyId ||
+    decodedKeyId.length !== KEY_ID_BYTES ||
+    iv.length !== GCM_IV_BYTES ||
+    ciphertext.length === 0 ||
+    tag.length !== GCM_TAG_BYTES ||
+    mac.length !== 32
+  ) {
+    return { isValid: false, isConfigurationError: false };
+  }
+
+  const key = keyring.keys.get(keyId);
+
+  if (!key) {
+    return { isValid: false, isConfigurationError: false };
+  }
+
+  const authenticatedPrefix = [format, keyId, ivValue, ciphertextValue, tagValue].join('.');
+  const expectedMac = createHmac('sha256', key.signingKey).update(authenticatedPrefix, 'utf8').digest();
+
+  if (expectedMac.length !== mac.length || !timingSafeEqual(expectedMac, mac)) {
+    return { isValid: false, isConfigurationError: false };
+  }
+
+  try {
+    const decipher = createDecipheriv('aes-256-gcm', key.encryptionKey, iv);
+    decipher.setAAD(Buffer.from(`${format}.${keyId}.${ivValue}`, 'utf8'));
+    decipher.setAuthTag(tag);
+
+    const plaintext = Buffer.concat([decipher.update(ciphertext), decipher.final()]).toString('utf8');
+    const claims = parseExactClaims(plaintext, now);
+
+    if (!claims) {
+      return { isValid: false, isConfigurationError: false };
+    }
+
+    return { isValid: true, claims };
+  } catch {
+    return { isValid: false, isConfigurationError: false };
+  }
+};
+
+const decodeMasterKey = (value: string | undefined): Buffer | null => {
+  if (!value || value.length !== 43 || !BASE64URL_PATTERN.test(value)) {
+    return null;
+  }
+
+  const decoded = decodeBase64Url(value);
+
+  if (!decoded || decoded.length !== MASTER_KEY_BYTES) {
+    return null;
+  }
+
+  return decoded;
+};
+
+const decodeBase64Url = (value: string): Buffer | null => {
+  if (!value || !BASE64URL_PATTERN.test(value)) {
+    return null;
+  }
+
+  try {
+    const decoded = Buffer.from(value, 'base64url');
+
+    if (decoded.length === 0 || decoded.toString('base64url') !== value) {
+      return null;
+    }
+
+    return decoded;
+  } catch {
+    return null;
+  }
+};
+
+const deriveKey = (masterKey: Buffer): DerivedKey => {
+  const keyId = createHash('sha256').update(masterKey).digest().subarray(0, KEY_ID_BYTES).toString('base64url');
+
+  return {
+    keyId,
+    encryptionKey: Buffer.from(hkdfSync('sha256', masterKey, HANDOFF_SALT, ENCRYPTION_INFO, 32)),
+    signingKey: Buffer.from(hkdfSync('sha256', masterKey, HANDOFF_SALT, SIGNING_INFO, 32)),
+  };
+};
+
+const parseExactClaims = (plaintext: string, now: number): LocaleHandoffClaims | null => {
+  let parsed: unknown;
+
+  try {
+    parsed = JSON.parse(plaintext) as unknown;
+  } catch {
+    return null;
+  }
+
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    return null;
+  }
+
+  const record = parsed as Record<string, unknown>;
+
+  if (
+    Object.keys(record).length !== CLAIM_KEYS.length ||
+    CLAIM_KEYS.some((key) => !Object.hasOwn(record, key)) ||
+    record.v !== 1 ||
+    record.iss !== ISSUER ||
+    record.aud !== AUDIENCE ||
+    typeof record.iat !== 'number' ||
+    !Number.isSafeInteger(record.iat) ||
+    typeof record.exp !== 'number' ||
+    !Number.isSafeInteger(record.exp) ||
+    (record.locale !== 'es' && record.locale !== 'en') ||
+    typeof record.targetPath !== 'string' ||
+    !TARGET_PATH_PATTERN.test(record.targetPath)
+  ) {
+    return null;
+  }
+
+  const claims: LocaleHandoffClaims = {
+    v: 1,
+    iss: ISSUER,
+    aud: AUDIENCE,
+    iat: record.iat,
+    exp: record.exp,
+    locale: record.locale,
+    targetPath: record.targetPath,
+  };
+
+  // JSON itself is part of the authenticated format. Reject alternate key
+  // orders, whitespace, and extra fields rather than merely normalizing them.
+  if (JSON.stringify(claims) !== plaintext) {
+    return null;
+  }
+
+  if (claims.exp !== claims.iat + TTL_SECONDS || claims.iat > now + CLOCK_SKEW_SECONDS || now > claims.exp) {
+    return null;
+  }
+
+  return claims;
+};
