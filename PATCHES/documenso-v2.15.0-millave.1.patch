+import { renderToStaticMarkup } from 'react-dom/server';
+import { describe, expect, it } from 'vitest';
+
+import { SOURCE_OFFER_URL, SourceOfferBanner } from './source-offer-banner';
+
+describe('SourceOfferBanner', () => {
+  it('provides a visible public source offer without sending the signing path as a referrer', () => {
+    const markup = renderToStaticMarkup(<SourceOfferBanner />);
+
+    expect(markup).toContain('>Source</a>');
+    expect(SOURCE_OFFER_URL).toBe(
+      'https://github.com/RealEstatePR/millave-documenso-source/tree/documenso-v2.15.0-millave.1',
+    );
+    expect(markup).toContain(
+      'href="https://github.com/RealEstatePR/millave-documenso-source/tree/documenso-v2.15.0-millave.1"',
+    );
+    expect(markup).toContain('target="_blank"');
+    expect(markup).toContain('rel="noopener noreferrer"');
+    expect(markup).toContain('referrerPolicy="no-referrer"');
+  });
+});
