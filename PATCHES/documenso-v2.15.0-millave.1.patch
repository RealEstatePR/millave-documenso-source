diff --git a/apps/remix/app/routes/api+/locale-handoff.test.ts b/apps/remix/app/routes/api+/locale-handoff.test.ts
new file mode 100644
index 0000000..a12f21b
--- /dev/null
+++ b/apps/remix/app/routes/api+/locale-handoff.test.ts
@@ -0,0 +1,184 @@
+import type { ActionFunctionArgs } from 'react-router';
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { localeHandoffLangCookie } from '~/storage/lang-cookie.server';
+import goldenVector from '../../../../../packages/lib/server-only/locale-handoff/locale-handoff-lh1-golden-vector.json';
+import { action } from './locale-handoff';
+
+const TEST_KEY = 'BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc';
+const REQUEST_URL = 'https://sign.millave.pr/api/locale-handoff';
+
+describe('locale handoff route', () => {
+  beforeEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllEnvs();
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY', TEST_KEY);
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY_PREVIOUS', '');
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_TRUST_RAILWAY_PROXY', '');
+    vi.spyOn(Date, 'now').mockReturnValue(1_700_000_000_000);
+  });
+
+  afterEach(() => {
+    vi.restoreAllMocks();
+    vi.unstubAllEnvs();
+  });
+
+  it('accepts the shared golden handoff and sets only the required language cookies', async () => {
+    const response = await invokeAction(createRequest({}, goldenVector.handoff));
+
+    expect(response.status).toBe(303);
+    expect(response.headers.get('Location')).toBe(goldenVector.claims.targetPath);
+    expectPrivacyHeaders(response);
+
+    const setCookies = getSetCookies(response);
+
+    expect(setCookies).toHaveLength(2);
+    expect(setCookies).toContain(
+      'lang=; Path=/; Domain=.millave.pr; Max-Age=0; Expires=Thu, 01 Jan 1970 00:00:00 GMT; HttpOnly; Secure; SameSite=Lax',
+    );
+
+    const expectedHostOnlyLocaleCookie = await localeHandoffLangCookie.serialize('es');
+    const hostOnlyLocaleCookie = setCookies.find((cookie) => cookie === expectedHostOnlyLocaleCookie);
+
+    expect(hostOnlyLocaleCookie).toBe(expectedHostOnlyLocaleCookie);
+    expect(hostOnlyLocaleCookie).not.toContain('Domain=');
+    expect(hostOnlyLocaleCookie).toContain('Path=/');
+    expect(hostOnlyLocaleCookie).toContain('HttpOnly');
+    expect(hostOnlyLocaleCookie).toContain('Secure');
+    expect(hostOnlyLocaleCookie).toContain('SameSite=Lax');
+  });
+
+  it('returns a private 404 without cookies or a redirect for tampered or malformed handoffs', async () => {
+    const lastCharacter = goldenVector.handoff.at(-1);
+    const tamperedHandoff = `${goldenVector.handoff.slice(0, -1)}${lastCharacter === 's' ? 't' : 's'}`;
+
+    for (const handoff of [tamperedHandoff, 'not-a-handoff']) {
+      const response = await invokeAction(createRequest({}, handoff));
+
+      expect(response.status).toBe(404);
+      expectPrivateFailureResponse(response);
+    }
+  });
+
+  it('returns a private 503 without cookies or a redirect for a malformed host key', async () => {
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY', 'not-a-32-byte-base64url-key');
+
+    const response = await invokeAction(createRequest({}, goldenVector.handoff));
+
+    expect(response.status).toBe(503);
+    expectPrivateFailureResponse(response);
+  });
+
+  it('returns a generic private 429 for concurrency exhaustion', async () => {
+    const blockingRequests = Array.from({ length: 20 }, () => createBlockingRequest());
+    const pendingResponses = blockingRequests.map(({ request }) => invokeAction(request));
+
+    const response = await invokeAction(createRequest());
+
+    expect(response.status).toBe(429);
+    expectPrivateFailureResponse(response);
+
+    for (const { release } of blockingRequests) {
+      release();
+    }
+
+    await Promise.all(pendingResponses);
+  });
+
+  it('uses canonical IP parsing and returns the same generic 429 when a trusted IP reaches its limit', async () => {
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_TRUST_RAILWAY_PROXY', 'true');
+
+    for (let requestNumber = 0; requestNumber < 31; requestNumber += 1) {
+      const response = await invokeAction(
+        createRequest({
+          'X-Railway-Edge': 'configured',
+          'X-Real-IP': '123.456.789.999',
+        }),
+      );
+
+      // The old character-class check accepted this malformed address. Node's
+      // parser rejects it, leaving only the global limit in effect.
+      expect(response.status).toBe(404);
+    }
+
+    let response: Response | null = null;
+
+    for (let requestNumber = 0; requestNumber < 31; requestNumber += 1) {
+      response = await invokeAction(
+        createRequest({
+          'X-Railway-Edge': 'configured',
+          'X-Real-IP': '203.0.113.7',
+        }),
+      );
+    }
+
+    expect(response?.status).toBe(429);
+    expectPrivateFailureResponse(response as Response);
+  });
+});
+
+const createRequest = (headers: Record<string, string> = {}, handoff = 'not-valid'): Request => {
+  const body = new URLSearchParams({ handoff }).toString();
+
+  return new Request(REQUEST_URL, {
+    method: 'POST',
+    headers: {
+      'Content-Length': String(Buffer.byteLength(body)),
+      'Content-Type': 'application/x-www-form-urlencoded',
+      Origin: 'https://millave.pr',
+      ...headers,
+    },
+    body,
+  });
+};
+
+const createBlockingRequest = (): { request: Request; release: () => void } => {
+  let controller: ReadableStreamDefaultController<Uint8Array> | null = null;
+  const body = new ReadableStream<Uint8Array>({
+    start(streamController) {
+      controller = streamController;
+    },
+  });
+  const request = new Request(REQUEST_URL, {
+    method: 'POST',
+    headers: {
+      'Content-Length': String(Buffer.byteLength('handoff=not-valid')),
+      'Content-Type': 'application/x-www-form-urlencoded',
+      Origin: 'https://millave.pr',
+    },
+    body,
+    duplex: 'half',
+  } as RequestInit);
+
+  return {
+    request,
+    release: () => controller?.close(),
+  };
+};
+
+const invokeAction = (request: Request): Promise<Response> =>
+  action({ request } as ActionFunctionArgs) as Promise<Response>;
+
+const getSetCookies = (response: Response): string[] => {
+  const headers = response.headers as Headers & { getSetCookie?: () => string[] };
+
+  return headers.getSetCookie?.() ?? [];
+};
+
+const expectPrivacyHeaders = (response: Response): void => {
+  expect(response.headers.get('Cache-Control')).toBe('no-store, no-cache, must-revalidate');
+  expect(response.headers.get('Pragma')).toBe('no-cache');
+  expect(response.headers.get('Expires')).toBe('0');
+  expect(response.headers.get('Content-Security-Policy')).toBe(
+    "default-src 'none'; base-uri 'none'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'",
+  );
+  expect(response.headers.get('Referrer-Policy')).toBe('no-referrer');
+  expect(response.headers.get('X-Content-Type-Options')).toBe('nosniff');
+  expect(response.headers.get('X-Robots-Tag')).toBe('noindex, nofollow, noarchive');
+};
+
+const expectPrivateFailureResponse = (response: Response): void => {
+  expectPrivacyHeaders(response);
+  expect(response.headers.get('Location')).toBeNull();
+  expect(getSetCookies(response)).toEqual([]);
+};
diff --git a/apps/remix/app/routes/api+/locale-handoff.tsx b/apps/remix/app/routes/api+/locale-handoff.tsx
new file mode 100644
index 0000000..6dccb9a
--- /dev/null
+++ b/apps/remix/app/routes/api+/locale-handoff.tsx
@@ -0,0 +1,307 @@
+import { isIP } from 'node:net';
+import {
+  getLocaleHandoffKeyring,
+  verifyLocaleHandoff,
+} from '@documenso/lib/server-only/locale-handoff/locale-handoff-token';
+import { env } from '@documenso/lib/utils/env';
+import type { ActionFunctionArgs, LoaderFunctionArgs } from 'react-router';
+
+import { localeHandoffLangCookie } from '~/storage/lang-cookie.server';
+
+const SOURCE_ORIGIN = 'https://millave.pr';
+const MAX_REQUEST_BYTES = 8_192;
+const MAX_HANDOFF_LENGTH = 4_096;
+const MAX_CONCURRENT_REQUESTS = 20;
+const GLOBAL_REQUEST_LIMIT = 300;
+const SOURCE_IP_REQUEST_LIMIT = 30;
+const RATE_LIMIT_WINDOW_MS = 60_000;
+const SOURCE_IP_CACHE_TTL_MS = 120_000;
+const MAX_SOURCE_IP_CACHE_ENTRIES = 10_000;
+const PRIVACY_HEADERS = {
+  'Cache-Control': 'no-store, no-cache, must-revalidate',
+  'Content-Security-Policy':
+    "default-src 'none'; base-uri 'none'; connect-src 'none'; form-action 'none'; frame-ancestors 'none'",
+  Expires: '0',
+  Pragma: 'no-cache',
+  'Referrer-Policy': 'no-referrer',
+  'X-Content-Type-Options': 'nosniff',
+  'X-Robots-Tag': 'noindex, nofollow, noarchive',
+};
+
+type SourceIpRateLimitEntry = {
+  count: number;
+  lastSeenAt: number;
+  windowStartedAt: number;
+};
+
+const sourceIpRateLimits = new Map<string, SourceIpRateLimitEntry>();
+let globalWindowStartedAt = 0;
+let globalRequestCount = 0;
+let activeRequestCount = 0;
+
+export const loader = (_args: LoaderFunctionArgs) => notFoundResponse();
+
+export const action = async ({ request }: ActionFunctionArgs) => {
+  if (!isAcceptableRequest(request)) {
+    return notFoundResponse();
+  }
+
+  if (!getLocaleHandoffKeyring().isValid) {
+    return unavailableResponse();
+  }
+
+  if (!tryAcquireConcurrencySlot()) {
+    return rateLimitedResponse();
+  }
+
+  try {
+    const sourceIp = getTrustedRailwayClientIp(request);
+
+    if (!isWithinRateLimit(sourceIp)) {
+      return rateLimitedResponse();
+    }
+
+    const handoff = await readHandoff(request);
+
+    if (!handoff) {
+      return notFoundResponse();
+    }
+
+    const verification = verifyLocaleHandoff(handoff);
+
+    if (!verification.isValid) {
+      return verification.isConfigurationError ? unavailableResponse() : notFoundResponse();
+    }
+
+    const headers = new Headers(PRIVACY_HEADERS);
+    headers.set('Location', verification.claims.targetPath);
+    headers.append('Set-Cookie', parentLangCookieDeletion);
+    headers.append('Set-Cookie', await localeHandoffLangCookie.serialize(verification.claims.locale));
+
+    return new Response(null, { status: 303, headers });
+  } finally {
+    releaseConcurrencySlot();
+  }
+};
+
+const isAcceptableRequest = (request: Request): boolean => {
+  if (request.method !== 'POST') {
+    return false;
+  }
+
+  if (request.headers.get('origin') !== SOURCE_ORIGIN) {
+    return false;
+  }
+
+  if (request.headers.get('content-type') !== 'application/x-www-form-urlencoded') {
+    return false;
+  }
+
+  const contentLength = request.headers.get('content-length');
+
+  if (!contentLength || !/^(0|[1-9][0-9]*)$/.test(contentLength)) {
+    return false;
+  }
+
+  const declaredLength = Number(contentLength);
+
+  if (!Number.isSafeInteger(declaredLength) || declaredLength > MAX_REQUEST_BYTES) {
+    return false;
+  }
+
+  return matchesFetchMetadata(request);
+};
+
+const matchesFetchMetadata = (request: Request): boolean => {
+  const expectedHeaders = [
+    ['sec-fetch-site', 'same-site'],
+    ['sec-fetch-mode', 'navigate'],
+    ['sec-fetch-dest', 'document'],
+  ] as const;
+
+  return expectedHeaders.every(([header, expectedValue]) => {
+    const value = request.headers.get(header);
+
+    return value === null || value === expectedValue;
+  });
+};
+
+const readHandoff = async (request: Request): Promise<string | null> => {
+  const contentLength = request.headers.get('content-length');
+  const expectedLength = contentLength ? Number(contentLength) : Number.NaN;
+
+  if (!Number.isSafeInteger(expectedLength) || !request.body) {
+    return null;
+  }
+
+  const reader = request.body.getReader();
+  const chunks: Uint8Array[] = [];
+  let totalLength = 0;
+
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+
+      if (done) {
+        break;
+      }
+
+      if (!value) {
+        continue;
+      }
+
+      totalLength += value.byteLength;
+
+      if (totalLength > MAX_REQUEST_BYTES) {
+        await reader.cancel();
+
+        return null;
+      }
+
+      chunks.push(value);
+    }
+
+    if (totalLength !== expectedLength) {
+      return null;
+    }
+
+    const body = new Uint8Array(totalLength);
+    let offset = 0;
+
+    for (const chunk of chunks) {
+      body.set(chunk, offset);
+      offset += chunk.byteLength;
+    }
+
+    const params = new URLSearchParams(new TextDecoder('utf-8', { fatal: true }).decode(body));
+    const entries = Array.from(params.entries());
+
+    if (entries.length !== 1 || entries[0][0] !== 'handoff') {
+      return null;
+    }
+
+    const handoff = entries[0][1];
+
+    if (handoff.length === 0 || handoff.length > MAX_HANDOFF_LENGTH) {
+      return null;
+    }
+
+    return handoff;
+  } catch {
+    return null;
+  }
+};
+
+const getTrustedRailwayClientIp = (request: Request): string | null => {
+  // This remains disabled unless the Railway operator has explicitly confirmed
+  // that direct ingress is blocked and Railway strips client-supplied proxy
+  // headers. Without that deployment invariant, forwarded headers are ignored.
+  if (env('ESIGN_LOCALE_HANDOFF_TRUST_RAILWAY_PROXY') !== 'true') {
+    return null;
+  }
+
+  if (!request.headers.get('x-railway-edge')) {
+    return null;
+  }
+
+  const clientIp = request.headers.get('x-real-ip');
+
+  if (!clientIp || isIP(clientIp) === 0) {
+    return null;
+  }
+
+  return clientIp;
+};
+
+const isWithinRateLimit = (sourceIp: string | null): boolean => {
+  const now = Date.now();
+  const windowStartedAt = now - (now % RATE_LIMIT_WINDOW_MS);
+
+  if (globalWindowStartedAt !== windowStartedAt) {
+    globalWindowStartedAt = windowStartedAt;
+    globalRequestCount = 0;
+  }
+
+  evictStaleSourceIpEntries(now);
+
+  let sourceIpEntry: SourceIpRateLimitEntry | null = null;
+
+  if (sourceIp) {
+    sourceIpEntry = sourceIpRateLimits.get(sourceIp) ?? null;
+
+    if (!sourceIpEntry || sourceIpEntry.windowStartedAt !== windowStartedAt) {
+      sourceIpEntry = { count: 0, lastSeenAt: now, windowStartedAt };
+    }
+
+    if (sourceIpEntry.count >= SOURCE_IP_REQUEST_LIMIT) {
+      return false;
+    }
+  }
+
+  if (globalRequestCount >= GLOBAL_REQUEST_LIMIT) {
+    return false;
+  }
+
+  globalRequestCount += 1;
+
+  if (sourceIp && sourceIpEntry) {
+    sourceIpEntry.count += 1;
+    sourceIpEntry.lastSeenAt = now;
+    sourceIpRateLimits.delete(sourceIp);
+    sourceIpRateLimits.set(sourceIp, sourceIpEntry);
+    trimSourceIpCache();
+  }
+
+  return true;
+};
+
+const evictStaleSourceIpEntries = (now: number): void => {
+  for (const [sourceIp, entry] of sourceIpRateLimits) {
+    if (now - entry.lastSeenAt > SOURCE_IP_CACHE_TTL_MS) {
+      sourceIpRateLimits.delete(sourceIp);
+    }
+  }
+};
+
+const trimSourceIpCache = (): void => {
+  while (sourceIpRateLimits.size > MAX_SOURCE_IP_CACHE_ENTRIES) {
+    const oldestSourceIp = sourceIpRateLimits.keys().next().value;
+
+    if (!oldestSourceIp) {
+      return;
+    }
+
+    sourceIpRateLimits.delete(oldestSourceIp);
+  }
+};
+
+const tryAcquireConcurrencySlot = (): boolean => {
+  if (activeRequestCount >= MAX_CONCURRENT_REQUESTS) {
+    return false;
+  }
+
+  activeRequestCount += 1;
+
+  return true;
+};
+
+const releaseConcurrencySlot = (): void => {
+  activeRequestCount = Math.max(0, activeRequestCount - 1);
+};
+
+const notFoundResponse = (): Response => new Response(null, { status: 404, headers: PRIVACY_HEADERS });
+
+const unavailableResponse = (): Response => new Response(null, { status: 503, headers: PRIVACY_HEADERS });
+
+const rateLimitedResponse = (): Response => new Response(null, { status: 429, headers: PRIVACY_HEADERS });
+
+const parentLangCookieDeletion = [
+  'lang=',
+  'Path=/',
+  'Domain=.millave.pr',
+  'Max-Age=0',
+  'Expires=Thu, 01 Jan 1970 00:00:00 GMT',
+  'HttpOnly',
+  'Secure',
+  'SameSite=Lax',
+].join('; ');
