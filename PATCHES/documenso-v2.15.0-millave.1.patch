diff --git a/packages/lib/server-only/locale-handoff/locale-handoff-token.test.ts b/packages/lib/server-only/locale-handoff/locale-handoff-token.test.ts
new file mode 100644
index 0000000..b6b491a
--- /dev/null
+++ b/packages/lib/server-only/locale-handoff/locale-handoff-token.test.ts
@@ -0,0 +1,118 @@
+import { createCipheriv, createHash, createHmac, hkdfSync } from 'node:crypto';
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+
+import goldenVector from './locale-handoff-lh1-golden-vector.json';
+import { verifyLocaleHandoff } from './locale-handoff-token';
+
+const TEST_KEY = 'BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc';
+const ROTATED_TEST_KEY = 'CAgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAg';
+const { handoff: GOLDEN_HANDOFF, claims: canonicalClaims } = goldenVector;
+
+describe('verifyLocaleHandoff', () => {
+  beforeEach(() => {
+    vi.unstubAllEnvs();
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY', TEST_KEY);
+  });
+
+  afterEach(() => {
+    vi.unstubAllEnvs();
+  });
+
+  it('accepts the deterministic lh1 golden vector and permits an in-lifetime replay', () => {
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_700_000_000)).toEqual({
+      isValid: true,
+      claims: canonicalClaims,
+    });
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_700_000_090)).toEqual({
+      isValid: true,
+      claims: canonicalClaims,
+    });
+  });
+
+  it('rejects a tampered handoff before decryption', () => {
+    const tampered = `${GOLDEN_HANDOFF.slice(0, -1)}${GOLDEN_HANDOFF.endsWith('s') ? 't' : 's'}`;
+
+    expect(verifyLocaleHandoff(tampered, 1_700_000_000)).toEqual({
+      isValid: false,
+      isConfigurationError: false,
+    });
+  });
+
+  it('rejects handoffs immediately after expiry while allowing only future iat skew', () => {
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_700_000_091)).toEqual({
+      isValid: false,
+      isConfigurationError: false,
+    });
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_699_999_970).isValid).toBe(true);
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_699_999_969)).toEqual({
+      isValid: false,
+      isConfigurationError: false,
+    });
+  });
+
+  it('accepts a previous key during rotation but rejects an ambiguous keyring', () => {
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY', ROTATED_TEST_KEY);
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY_PREVIOUS', TEST_KEY);
+
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_700_000_000).isValid).toBe(true);
+
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY', TEST_KEY);
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY_PREVIOUS', TEST_KEY);
+
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_700_000_000)).toEqual({
+      isValid: false,
+      isConfigurationError: true,
+    });
+  });
+
+  it('fails closed when the dedicated key is missing or malformed', () => {
+    vi.stubEnv('ESIGN_LOCALE_HANDOFF_KEY', 'not-a-32-byte-base64url-key');
+
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_700_000_000)).toEqual({
+      isValid: false,
+      isConfigurationError: true,
+    });
+
+    vi.unstubAllEnvs();
+
+    expect(verifyLocaleHandoff(GOLDEN_HANDOFF, 1_700_000_000)).toEqual({
+      isValid: false,
+      isConfigurationError: true,
+    });
+  });
+
+  it('rejects authenticated claims outside the exact lh1 contract', () => {
+    const wrongVersion = createHandoff({ ...canonicalClaims, v: 2 });
+    const wrongIssuer = createHandoff({ ...canonicalClaims, iss: 'https://not-millave.pr' });
+    const wrongAudience = createHandoff({ ...canonicalClaims, aud: 'https://not-sign.millave.pr' });
+    const overlongExpiry = createHandoff({ ...canonicalClaims, exp: canonicalClaims.iat + 91 });
+    const wrongLocale = createHandoff({ ...canonicalClaims, locale: 'fr' });
+    const wrongTarget = createHandoff({ ...canonicalClaims, targetPath: '/documents/1234567890abcdef' });
+
+    for (const handoff of [wrongVersion, wrongIssuer, wrongAudience, overlongExpiry, wrongLocale, wrongTarget]) {
+      expect(verifyLocaleHandoff(handoff, 1_700_000_000)).toEqual({
+        isValid: false,
+        isConfigurationError: false,
+      });
+    }
+  });
+});
+
+const createHandoff = (claims: Record<string, unknown>): string => {
+  const masterKey = Buffer.from(TEST_KEY, 'base64url');
+  const keyId = createHash('sha256').update(masterKey).digest().subarray(0, 8).toString('base64url');
+  const salt = createHash('sha256').update('millave-esign-locale-handoff-lh1').digest();
+  const encryptionKey = Buffer.from(hkdfSync('sha256', masterKey, salt, Buffer.from('lh1/encryption', 'utf8'), 32));
+  const signingKey = Buffer.from(hkdfSync('sha256', masterKey, salt, Buffer.from('lh1/signing', 'utf8'), 32));
+  const iv = Buffer.alloc(12, 3);
+  const prefix = `lh1.${keyId}.${iv.toString('base64url')}`;
+  const cipher = createCipheriv('aes-256-gcm', encryptionKey, iv);
+  cipher.setAAD(Buffer.from(prefix, 'utf8'));
+
+  const ciphertext = Buffer.concat([cipher.update(JSON.stringify(claims), 'utf8'), cipher.final()]);
+  const outerPrefix = `${prefix}.${ciphertext.toString('base64url')}.${cipher.getAuthTag().toString('base64url')}`;
+  const mac = createHmac('sha256', signingKey).update(outerPrefix, 'utf8').digest().toString('base64url');
+
+  return `${outerPrefix}.${mac}`;
+};
